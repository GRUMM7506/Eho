{
  "name": "echo-game",
  "private": true,
  "version": "1.1.0",
  "description": "ЭХО — 3D-головоломка о команде из собственных прошлых попыток",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "solve": "tsx tools/solver.ts",
    "icons": "tsx tools/icons.ts",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "electron": "npm run build && electron .",
    "build:win": "npm run build && electron-builder --win",
    "build:android": "npm run build && npx cap sync android && cd android && gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "main": "electron/main.cjs",
  "author": "ECHO",
  "homepage": "./",
  "build": {
    "appId": "com.echopuzzle.game",
    "productName": "ECHO",
    "copyright": "ECHO",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ЭХО",
      "artifactName": "ECHO-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "ECHO-Portable-${version}.exe"
    }
  }
}
